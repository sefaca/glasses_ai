# Copiar a .env.local y rellenar. .env.local NO se versiona.
#
# SIN ninguna clave el producto funciona igual: cae al proveedor mock y las
# tarjetas muestran el esquema a escala en vez de una imagen generada. Es lo
# que permite desarrollar sin gastar dinero en cada recarga.
#
# Todas estas son de SERVIDOR. Ninguna lleva prefijo NEXT_PUBLIC_ a
# propósito: una clave con ese prefijo acaba en el bundle del navegador y,
# con ella, en manos de cualquiera → CLAUDE.md regla 6.

# ─── OpenAI ──────────────────────────────────────────────────────────────
#
# Es el proveedor que generó el mockup de referencia, así que su fidelidad ya
# se ha visto sobre una cara real. Clave: https://platform.openai.com/api-keys
#
# Ojo con el coste: OpenAI factura las imágenes POR TOKENS, no con tarifa
# plana. La estimación del código (~0,10 €/imagen en calidad alta) es para la
# contabilidad interna; el número real hay que leerlo del panel de
# facturación tras las primeras llamadas.
OPENAI_API_KEY=

# ─── Google Gemini ───────────────────────────────────────────────────────
#
# Alternativa con precio plano por imagen, que hace la economía más
# predecible. Clave: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Selección ───────────────────────────────────────────────────────────
#
# openai | gemini | mock. Si se omite, se usa la primera clave que haya,
# empezando por OpenAI.
TRYON_PROVIDER=openai

# Calidad (solo OpenAI): low | medium | high | auto.
#
# Medido el 2026-10-11 sobre el mismo retrato y la misma montura:
#   high    ~68 s   no cabe en una peticion web
#   medium  ~30 s   la montura se reconoce igual de bien  <- por defecto
#
# Cualquier valor desconocido se ignora y se usa el de por defecto.
TRYON_QUALITY=medium

# Modelo, dentro del proveedor elegido. Si se omite, el de por defecto.
#
#   OpenAI    gpt-image-2               por defecto
#             gpt-image-2.5-flare       más rápido
#             gpt-image-2.5-sunburst    más detalle, más lento y más caro
#
#   Gemini    gemini-3.1-flash-lite-image   ~0,03 €   el más barato
#             gemini-3.1-flash-image        ~0,06 €   por defecto
#             gemini-3-pro-image            ~0,11 €   mejor con referencias
#
# Ojo con la economía: el gate GC-5 pide ≤0,10 € por usuario activo, así que
# generar cuatro imágenes de golpe ya se lo come. Por eso la generación es
# bajo demanda y no automática.
TRYON_MODEL=

# ─── Puerta de acceso ────────────────────────────────────────────────────
#
# Código compartido que convierte una URL pública en una alfa privada. En
# local se deja VACÍO y no hay puerta.
#
# En producción con clave de proveedor es OBLIGATORIO: nuestro límite de uso
# vive en memoria del proceso y en serverless cada instancia lleva su propia
# cuenta, así que contra un script no sirve de nada, y cada generación son
# ~0,10 € de tu bolsillo.
#
# No es autenticación y no lo pretende. No sustituye al límite de gasto duro
# del panel del proveedor, que es la única red que no depende de este código.
ACCESS_CODE=

# ─── Supabase ────────────────────────────────────────────────────────────
#
# Hoy solo lo usa la lista de espera. Sin estas dos variables el embudo de
# captación se construye igual pero responde «no disponible» en vez de
# fingir que ha guardado el correo: prometer un aviso que nadie podrá
# enviar es mentir.
#
# Antes de rellenarlas, ejecuta `supabase/migrations/0001_waitlist.sql` en el
# editor SQL del proyecto.
#
# SUPABASE_SERVICE_ROLE_KEY **salta las políticas de fila**. Nunca lleva
# prefijo NEXT_PUBLIC_, nunca toca el navegador y nunca se commitea: con ella
# cualquiera puede leer la lista entera → CLAUDE.md regla 6.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sesión ──────────────────────────────────────────────────────────────
#
# Firma la cookie de sesión. Sin esto **no hay registro**: la ruta responde
# «no disponible» en vez de emitir una sesión que cualquiera podría falsificar.
#
# Cualquier cadena larga y aleatoria vale: `openssl rand -base64 32`.
# Cambiarla cierra la sesión de todo el mundo, que es justamente lo que hay
# que hacer si alguna vez se filtra.
SESSION_SECRET=

# ─── Tope de gasto ───────────────────────────────────────────────────────
#
# Número máximo de generaciones de TODO el sitio en un día. Es un límite de
# gasto, no de producto: a ~0,10 € cada una, 50 son 5 € al día como máximo
# absoluto.
#
# Es el único de los tres topes que acota la factura de verdad. Los otros dos
# -por sesión anónima y por cuenta- se saltan tirando la cookie o creando
# cuentas; este no.
#
# Si se omite, o si se pone algo que no es un número positivo, valen 50. Nunca
# cae a ilimitado.
DAILY_GENERATION_CAP=50

# ─── Analítica ───────────────────────────────────────────────────────────
#
# `null` descarta los eventos en silencio, para desarrollar sin ensuciar la
# consola. Cualquier otro valor (o ninguno) los escribe en el log del
# servidor.
ANALYTICS_SINK=
