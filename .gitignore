# Datos de validación con material sensible
# Fotos de personas y outputs generados: NO deben versionarse nunca.
/research/**/faces/
/research/**/outputs/
*.heic

# Material en bruto: datos personales (grabaciones, transcripciones literales,
# consentimientos firmados), material de terceros bajo NDA (propuestas,
# presupuestos) y originales binarios pesados. Al repo solo llega la versión
# anonimizada o el dato resumido. Ver research/README.md §2.
/research/**/raw/

